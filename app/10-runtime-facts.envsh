#!/bin/sh
# Sourced by the NGINX entrypoint before the template is rendered, so what it
# exports is available to envsubst. Files ending in .envsh are sourced rather
# than executed, which is what lets an export survive into the next script.
#
# The uid is read from the running process rather than copied from the Pod
# spec, so the page reports what the container is, not what it was asked to be.
export RUNTIME_UID="$(id -u)"

# Every variable the template names must be defined, including outside
# Kubernetes. envsubst leaves an undefined ${NAME} untouched, nginx then reads
# the leftover as one of its own variables, and the container exits with
# "unknown \"name\" variable" before it ever serves a request.
export POD_NAME="${POD_NAME:-unknown}"
export POD_NAMESPACE="${POD_NAMESPACE:-unknown}"
export POD_IP="${POD_IP:-unknown}"
export NODE_NAME="${NODE_NAME:-unknown}"
export IMAGE_DIGEST="${IMAGE_DIGEST:-unknown}"
